{
    "name": "phpbbmodders/autodbbackup",
    "type": "phpbb-extension",
    "description": "Automatically backs up your database using phpBB cron.",
    "homepage": "https://www.phpbbmodders.com/",
    "version": "2.2.0-dev",
    "time": "2026-11-07",
    "keywords": [
        "phpbb",
        "extension",
        "auto",
        "database",
        "backup"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        },
        {
            "name": "Rich McGirr",
            "role": "Past Developer"
        },
        {
            "name": "Lukasz Kaczynski",
            "role": "Past Developer"
        }
    ],
    "require": {
        "php": ">=8.3.36",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpbb/epv": "dev-master"
    },
    "extra": {
        "display-name": "Auto Database Backup",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/auto_database_backup_2",
            "filename": "version_check",
            "ssl": true
        }
    }
}
